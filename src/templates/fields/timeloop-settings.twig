{% import "_includes/forms" as forms %}

{{ forms.lightswitchField({
    label: 'Show times'|t('timeloop'),
    instructions: 'Add a start time and end time to each occurrence.'|t('timeloop'),
    name: 'showTime',
    on: settings.showTime,
}) }}

{{ forms.textField({
    label: 'Default holidays country'|t('timeloop'),
    instructions: 'Two-letter country code used when a value enables holidays without picking one. Leave blank to derive it from the site locale.'|t('timeloop'),
    name: 'defaultHolidaysCountry',
    value: settings.defaultHolidaysCountry,
    placeholder: 'be',
    size: 6,
    errors: field is defined ? field.getErrors('defaultHolidaysCountry') : null,
}) }}
